# Variables PÚBLICAS del frontend (prefijo VITE_): se compilan en el bundle.
#   - Local:      copia a .env.local
#   - Producción: Cloudflare -> Pages -> Settings -> Environment variables
#
# Analítica / marketing. IDs públicos por diseño; VACÍO = ese sistema NO se carga.
# La carga está consent-gated (banner de cookies): nada se activa sin "Aceptar".

# Google Analytics 4 (G-XXXXXXXXXX)
VITE_GA_ID=
# Google Tag Manager (GTM-XXXXXXX)
VITE_GTM_ID=
# Meta / Facebook Pixel (ID numérico)
VITE_META_PIXEL_ID=
# Google Ads (AW-XXXXXXXXXX)
VITE_GOOGLE_ADS_ID=
# Etiqueta de conversión de Google Ads (la parte tras la barra en el snippet)
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# ---------------------------------------------------------------------------
# El formulario "Aplicar" usa secrets DEL SERVIDOR (Resend), que NO van aquí:
#   - Local:      .dev.vars (ver .dev.vars.example)
#   - Producción: Cloudflare -> Pages -> Settings -> Environment variables (Secret)
