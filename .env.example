# =============================================================================
# Plantilla de variables de entorno. Copia a .env.local para desarrollo.
# NUNCA commitees .env / .env.local con valores reales (ver .gitignore).
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# IMPORTANTE (Zero Trust / honestidad técnica):
# Toda variable con prefijo VITE_ se COMPILA dentro del bundle del cliente y por
# tanto es PÚBLICA y visible en el navegador. Esto es correcto para la ANON KEY:
# su seguridad NO depende de ocultarla, sino de Row Level Security (RLS) en la BD.
#
# Controles reales sobre estas variables:
#  1. Definirlas en Vercel SOLO en el scope Production (y Preview si se requiere).
#  2. No commitearlas nunca (este archivo es solo la plantilla).
#  3. La protección de los datos vive en RLS (migración 0001_applications.sql).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- PROHIBIDO en el cliente -------------------------------------------------
# La service_role key BYPASSA RLS. JAMÁS con prefijo VITE_ ni en el frontend.
# Úsala solo en entornos de servidor (Edge Function / backend), SIN prefijo VITE_:
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-the-client
